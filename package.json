{
  "name": "frontier",
  "version": "0.1.0",
  "description": "MCP server for building verified historical timelines and tracking the research frontier of technical fields.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "frontier": "dist/main.js"
  },
  "files": [
    "dist",
    "manifest.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test \"test/**/*.test.js\"",
    "record-fixtures": "node scripts/record-fixtures.mjs",
    "bundle": "node scripts/build-bundle.mjs",
    "pin-yc-rfs": "node scripts/pin-yc-rfs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fast-xml-parser": "^5.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
